<?xml version="1.0" encoding="utf-8"?>
<!--
  Fossify Commons' sideloading check (Activity.isAppSideloaded) loads
  org.fossify.commons.R.drawable.ic_camera_vector and treats a load failure as
  "this build is corrupt/sideloaded", showing a blocking dialog. The drawable is
  otherwise unreferenced, so resource shrinking strips it from our release build
  and the check fails. Keep it so the probe always succeeds.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_camera_vector" />
